{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "daftar/components/calendar/**",
              "daftar/components/core/**",
              "daftar/components/deen/**",
              "daftar/desktop/**",
              "daftar/docs/**",
              "daftar/mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|IBM Plex Mono|Amiri|Newsreader|Spectral|Karla))/i]",
        "message": "Font not provided by the design system. Available: Inter, IBM Plex Mono, Amiri, Newsreader, Spectral, Karla."
      },
      {
        "selector": "JSXOpeningElement[name.name='AhdTracker'] > JSXAttribute > JSXIdentifier[name!=/^(?:routines|onEdit|editLabel|key|ref|className|style|children)$/]",
        "message": "<AhdTracker> doesn't accept that prop. Declared props: routines, onEdit, editLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnchoredTasks'] > JSXAttribute > JSXIdentifier[name!=/^(?:tasks|onToggle|source|key|ref|className|style|children)$/]",
        "message": "<AnchoredTasks> doesn't accept that prop. Declared props: tasks, onToggle, source."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|quiet|surface)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'quiet' | 'surface'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|key|ref|className|style|children)$/]",
        "message": "<ConfidenceChip> doesn't accept that prop. Declared props: state, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:provisional|confirmed|firm)$/]",
        "message": "<ConfidenceChip> state must be one of 'provisional' | 'confirmed' | 'firm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:hijri|greg|today|selected|dim|moon|tag|tagStyle|page|trace|chips|anchored|chipVariant|span|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<DayCell> doesn't accept that prop. Declared props: hijri, greg, today, selected, dim, moon, tag, tagStyle, page, trace, chips, anchored, chipVariant, span, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayCell'] > JSXAttribute[name.name='chipVariant'] > Literal[value!=/^(?:square|bar)$/]",
        "message": "<DayCell> chipVariant must be one of 'square' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|ink|time|label|variant|key|ref|className|style|children)$/]",
        "message": "<EventChip> doesn't accept that prop. Declared props: color, ink, time, label, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventChip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:square|bar)$/]",
        "message": "<EventChip> variant must be one of 'square' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HijriMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tile|variant|crescent|radius|key|ref|className|style|children)$/]",
        "message": "<HijriMark> doesn't accept that prop. Declared props: size, tile, variant, crescent, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='HijriMark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:night|paper|gold|flat)$/]",
        "message": "<HijriMark> variant must be one of 'night' | 'paper' | 'gold' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MiniMonth'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|weekdays|leading|days|today|selected|onSelect|yearLabel|onYear|key|ref|className|style|children)$/]",
        "message": "<MiniMonth> doesn't accept that prop. Declared props: title, weekdays, leading, days, today, selected, onSelect, yearLabel, onYear."
      },
      {
        "selector": "JSXOpeningElement[name.name='SalahTimes'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|nextIndex|authority|place|arabic|footer|key|ref|className|style|children)$/]",
        "message": "<SalahTimes> doesn't accept that prop. Declared props: rows, nextIndex, authority, place, arabic, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='ViewSwitcher'] > JSXAttribute > JSXIdentifier[name!=/^(?:views|value|onChange|key|ref|className|style|children)$/]",
        "message": "<ViewSwitcher> doesn't accept that prop. Declared props: views, value, onChange."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
