<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- tamescroll in-app updater (owner ask 2026-08-23): sideload the
         latest build without re-sending the APK. The system installer
         still confirms every install with the user. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- 1108: the link-ownership flow reads YouTube's Open-by-default
         state and opens its settings pages. Package visibility (API 30+)
         is needed for both; no other package is ever queried. -->
    <queries>
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.app"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- density|fontScale added to configChanges: any config change NOT
             listed there recreates the Activity under the live Rust process,
             which renders permanently blank (Tauri cannot attach a fresh
             Activity — see MainActivity Back-handling comment). -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- tamescroll (1107): OWN THE LINK. The owner's test for
                 whether the app is useful at all: "someone sends a link
                 on WhatsApp and we open it and the normal YouTube opens,
                 so there is no point." No autoVerify: that needs an
                 assetlinks.json on youtube.com, which is not ours, so on
                 Android 12+ the user enables it once under Open by
                 default and the launcher walks them there
                 (TsLinks.openDefaultApps). Hosts are the set the YouTube
                 app itself claims; anything else stays with the browser. -->
            <intent-filter android:label="@string/main_activity_title">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="youtu.be" />
            </intent-filter>
            <!-- Share-sheet target. Works with NO default-app setting:
                 YouTube -> Share -> tamescroll, or a chat link shared.
                 The reliable fallback for a user who never finds Open by
                 default. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- tamescroll: per-platform home-screen shortcuts -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".BenchActivity" android:exported="true" android:label="tsbench" />
    </application>
</manifest>
